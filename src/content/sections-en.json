{
  "about": "<section class=\"sw sw-about\" id=\"about\" aria-labelledby=\"about-title\">\n      <div class=\"sw-hero\"><div class=\"sw-hero-in\">\n        <header class=\"sw-head sw-grid\" data-i18n=\"aboutHead\"><p class=\"sw-label\"><span>(01)</span> About me</p><p class=\"sw-label sw-r\">AIGC &amp; interaction designer · Beijing</p></header>\n        <h2 class=\"sw-big sw-grid\" id=\"about-title\" data-split=\"\" data-early=\"\">\n          <span class=\"ln c1\" data-drift=\"-0.6\" data-i18n=\"hi1\">Hi,</span>\n          <span class=\"ln c5\" data-drift=\"0.6\" data-i18n=\"hi2\">I’m Xianlin —</span>\n          <span class=\"ln c2\" data-drift=\"-0.4\" data-i18n=\"hi3\">designer</span>\n        </h2>\n        <figure class=\"sw-ig\">\n          <a class=\"ig-stage\" href=\"https://www.behance.net/xianlinlu\" target=\"_blank\" rel=\"noopener\" aria-label=\"Xianlin Lu portfolio\"><canvas class=\"ig-gl\" aria-hidden=\"true\"></canvas><span class=\"ig-tag\" aria-hidden=\"true\" data-i18n=\"igTag\">Explore my portfolio ↗</span></a>\n          <figcaption><span class=\"sw-label\">Portfolio</span><a class=\"ig-link\" href=\"https://www.behance.net/xianlinlu\" target=\"_blank\" rel=\"noopener\">@xianlinlu ↗</a></figcaption>\n        </figure>\n      </div></div>\n      <div class=\"sw-rest\">\n      <div class=\"sw-grid sw-intro\">\n        <figure class=\"sw-photo\" data-reveal=\"\"><img src=\"/images/xianlin-lu.png\" alt=\"Xianlin Lu\" data-i18n-attr=\"alt:photo\" width=\"900\" height=\"900\" loading=\"lazy\"></figure>\n        \n        <p class=\"sw-lead\" data-split=\"\" data-i18n=\"lead\">I explore AIGC <span class=\"tile ic ic-creative\">✦</span>, interfaces <span class=\"tile ic ic-web\">▣</span>, immersive experiences <span class=\"tile ic ic-motion\">▶</span> and visual communication. <span class=\"dim\">Connecting design and engineering to make complex ideas clear.</span></p>\n      </div>\n      <ul class=\"sw-stats\" aria-label=\"In short\" data-i18n-attr=\"aria-label:stats\">\n        <li class=\"sw-grid\" data-reveal=\"\"><b class=\"sw-num\">2021</b><span class=\"sw-label\" data-i18n=\"years\">professional design since 2021</span></li>\n        <li class=\"sw-grid\" data-reveal=\"\"><b class=\"sw-num\">2025</b><span class=\"sw-label\" data-i18n=\"freelance\">exploring AIGC at ByteDance</span></li>\n      </ul>\n      <p class=\"sw-quote sw-grid\" data-split=\"\" data-i18n=\"quote\"><span class=\"ln c1\">Curiosity</span><span class=\"ln c5\">meets</span><span class=\"ln c2\">design &amp;</span><span class=\"ln c5\">technology</span></p>\n      </div>\n    </section>",
