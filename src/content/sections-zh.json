{
  "about": "<section class=\"sw sw-about\" id=\"about\" aria-labelledby=\"about-title\">\n      <div class=\"sw-hero\"><div class=\"sw-hero-in\">\n        <header class=\"sw-head sw-grid\" data-i18n=\"aboutHead\"><p class=\"sw-label\"><span>(01)</span> 关于我</p><p class=\"sw-label sw-r\">AIGC 与交互设计师 · 北京</p></header>\n        <h2 class=\"sw-big sw-grid\" id=\"about-title\" data-split=\"\" data-early=\"\">\n          <span class=\"ln c1\" data-drift=\"-0.6\" data-i18n=\"hi1\">你好，</span>\n          <span class=\"ln c5\" data-drift=\"0.6\" data-i18n=\"hi2\">Xianlin Lu</span>\n          <span class=\"ln c2\" data-drift=\"-0.4\" data-i18n=\"hi3\">设计师</span>\n        </h2>\n        <figure class=\"sw-ig\">\n          <a class=\"ig-stage\" href=\"https://xianlinlu.webflow.io/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Xianlin Lu portfolio\"><canvas class=\"ig-gl\" aria-hidden=\"true\"></canvas><span class=\"ig-tag\" aria-hidden=\"true\" data-i18n=\"igTag\">查看我的作品集 ↗</span></a>\n          <figcaption><span class=\"sw-label\">Portfolio</span><a class=\"ig-link\" href=\"https://xianlinlu.webflow.io/\" target=\"_blank\" rel=\"noopener\">@xianlinlu ↗</a></figcaption>\n        </figure>\n      </div></div>\n      <div class=\"sw-rest\">\n      <div class=\"sw-grid sw-intro\">\n        <figure class=\"sw-photo\" data-reveal=\"\"><img src=\"/images/xianlin-lu.png\" alt=\"Xianlin Lu\" data-i18n-attr=\"alt:photo\" width=\"900\" height=\"900\" loading=\"lazy\"></figure>\n        \n        <p class=\"sw-lead\" data-split=\"\" data-i18n=\"lead\">我探索 AIGC 视觉 <span class=\"tile ic ic-creative\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3c.6 4.6 3.4 7.4 8 8-4.6.6-7.4 3.4-8 8-.6-4.6-3.4-7.4-8-8 4.6-.6 7.4-3.4 8-8z\" fill=\"#fff\" /></svg></span>、网页 <span class=\"tile ic ic-web\" aria-hidden=\"true\"><svg viewBox=\"0 0 32 24\"><rect x=\"4\" y=\"4\" width=\"24\" height=\"16\" rx=\"3\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" /><path d=\"M4 9h24\" stroke=\"#fff\" stroke-width=\"2.2\" /><circle cx=\"8\" cy=\"6.6\" r=\"1\" fill=\"#fff\" /><circle cx=\"11\" cy=\"6.6\" r=\"1\" fill=\"#fff\" /></svg></span>、动态设计 <span class=\"tile ic ic-motion\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 6.5v11l9-5.5z\" fill=\"#fff\" /></svg></span> 与品牌体验 <span class=\"tile ic ic-brand\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 4l2.2 5.2L20 10l-4.3 3.8L17 20l-5-3-5 3 1.3-6.2L4 10l5.8-.8z\" fill=\"#051727\" /></svg></span>。<span class=\"dim\"><span>连接设计与技术，</span><span>让复杂的想法</span><span>清晰可感。</span></span></p>\n      </div>\n      <ul class=\"sw-stats\" aria-label=\"个人概况\" data-i18n-attr=\"aria-label:stats\">\n        <li class=\"sw-grid\" data-reveal=\"\"><b data-from=\"2014\" data-count=\"2021\" class=\"sw-num\">2021</b><span class=\"sw-label\" data-i18n=\"years\">自 2021 年从事专业设计</span></li>\n        <li class=\"sw-grid\" data-reveal=\"\"><b data-from=\"2021\" data-count=\"2025\" class=\"sw-num\">2025</b><span class=\"sw-label\" data-i18n=\"freelance\">在字节跳动探索 AIGC</span></li>\n      </ul>\n      <p class=\"sw-quote sw-grid\" data-split=\"\" data-i18n=\"quote\"><span class=\"ln c1\"><span class=\"q\">以好奇心</span> <span class=\"q q-r\">探索</span></span><span class=\"ln c5\"><span class=\"q q-r\">设计 —</span></span><span class=\"ln c2\"><span class=\"q\">让想法</span> <span class=\"q q-i\">成为</span></span><span class=\"ln c5\"><span class=\"q q-r\">体验</span></span></p>\n      </div>\n    </section>",
  "numbers": "<section class=\"sw-numbers\" id=\"numbers\" aria-labelledby=\"nums-title\">\n      <div class=\"nums-stage\" data-mesh=\"\">\n        <div class=\"nums-track\">\n          <div class=\"nums-intro\"><p class=\"sw-label\" data-i18n=\"nums\"><span>(02)</span> 数字展示 · 视觉参考</p><h2 class=\"nums-title\" id=\"nums-title\" data-i18n=\"numsTitle\">让设计<br>创造价值</h2></div>\n          <div class=\"num\"><span class=\"num-i\">01</span><b data-count=\"836\">836</b><span class=\"num-l\" data-i18n=\"n1\">横幅设计</span></div>\n          <div class=\"num\"><span class=\"num-i\">02</span><b data-count=\"372\">372</b><span class=\"num-l\" data-i18n=\"n2\">动态设计</span></div>\n          <div class=\"num\"><span class=\"num-i\">03</span><b data-count=\"116\">116</b><span class=\"num-l\" data-i18n=\"n3\">演示文稿</span></div>\n          <div class=\"num\"><span class=\"num-i\">04</span><b data-count=\"42\">42</b><span class=\"num-l\" data-i18n=\"n4\">网站</span></div>\n          <div class=\"num\"><span class=\"num-i\">05</span><b data-count=\"18\">18</b><span class=\"num-l\" data-i18n=\"n5\">品牌手册</span></div>\n          <div class=\"num\"><span class=\"num-i\">06</span><b data-count=\"14\">14</b><span class=\"num-l\" data-i18n=\"n6\">社交媒体设计</span></div>\n          <div class=\"num\"><span class=\"num-i\">07</span><b data-count=\"100\" data-suffix=\"+\">100+</b><span class=\"num-l\" data-i18n=\"n7\">印刷版式</span></div>\n          <div class=\"num\"><span class=\"num-i\">08</span><b data-count=\"100\" data-suffix=\"+\">100+</b><span class=\"num-l\" data-i18n=\"n8\">宣传视频</span></div>\n        </div>\n        <div class=\"nums-fade\" aria-hidden=\"true\"></div>\n      </div>\n    </section>",
  "work": "<section class=\"works\" id=\"work\" aria-labelledby=\"work-title\">\n      <div class=\"works-stage\">\n        <canvas class=\"works-gl\" aria-hidden=\"true\"></canvas>\n        <p class=\"sw-label works-note\" data-i18n=\"workNote\"><span>(03)</span> 视觉参考展示</p>\n        <div class=\"works-copy\">\n          <h2 class=\"works-title\" id=\"work-title\" data-i18n=\"workTitle\">视觉创意</h2>\n          <p class=\"works-sub\" data-i18n=\"workSub\">（横幅 · 社交帖子 · 限时动态）</p>\n          <a rel=\"noopener noreferrer\" target=\"_blank\" class=\"btn works-btn\" data-i18n=\"viewAll\" href=\"https://xianlinlu.webflow.io/\">我的作品集 ↗</a>\n        </div>\n        <nav class=\"works-dots\" aria-label=\"作品类别\" data-i18n-attr=\"aria-label:dots\">\n          <button type=\"button\" class=\"on\" aria-label=\"视觉创意\" data-i18n-attr=\"aria-label:dot1\"></button><button type=\"button\" aria-label=\"网页设计\" data-i18n-attr=\"aria-label:dot2\"></button>\n          <button type=\"button\" aria-label=\"动态设计\" data-i18n-attr=\"aria-label:dot3\"></button><button type=\"button\" aria-label=\"标志与品牌\" data-i18n-attr=\"aria-label:dot4\"></button>\n        </nav>\n      </div>\n    </section>",
  "contact": "<footer class=\"sw sw-foot\" id=\"contact\" aria-labelledby=\"cta-title\">\n      <header class=\"sw-head sw-grid\" data-i18n=\"contactHead\"><p class=\"sw-label\"><span>(05)</span> 联系</p><p class=\"sw-label sw-r\">一起探索新的可能</p></header>\n      <h2 class=\"sw-big sw-grid\" id=\"cta-title\" data-split=\"\"><span class=\"ln c1\" data-drift=\"-0.8\" data-i18n=\"cta1\">一起聊聊</span><span class=\"ln c4\" data-drift=\"0.8\" data-i18n=\"cta2\">你的项目？</span></h2>\n      <ul class=\"sw-links\">\n        <li data-reveal=\"\"><a class=\"sw-grid\" href=\"mailto:luxianlin68@gmail.com\"><span class=\"sw-label\">01</span><b>Email</b><span class=\"sw-note\">luxianlin68@gmail.com</span><svg class=\"ico\" aria-hidden=\"true\"><use href=\"#i-ne\" /></svg></a></li>\n        <li data-reveal=\"\"><a class=\"sw-grid\" href=\"https://www.linkedin.com/in/xianlin-lu/\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"sw-label\">02</span><b>LinkedIn</b><span class=\"sw-note\">xianlin-lu</span><svg class=\"ico\" aria-hidden=\"true\"><use href=\"#i-ne\" /></svg></a></li>\n        <li data-reveal=\"\"><a class=\"sw-grid\" href=\"https://www.behance.net/xianlinlu\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"sw-label\">03</span><b>Behance</b><span class=\"sw-note\" data-i18n=\"cases\">xianlinlu</span><svg class=\"ico\" aria-hidden=\"true\"><use href=\"#i-ne\" /></svg></a></li>\n        <li data-reveal=\"\"><a class=\"sw-grid\" href=\"https://xianlinlu.webflow.io/\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"sw-label\">04</span><b>Portfolio</b><span class=\"sw-note\" data-i18n=\"links\">Selected work</span><svg class=\"ico\" aria-hidden=\"true\"><use href=\"#i-ne\" /></svg></a></li>\n      </ul>\n      <div class=\"sw-formwrap\" data-reveal=\"\">\n        <form class=\"sw-formcard\" id=\"brief\" data-mesh=\"\" aria-labelledby=\"form-title\">\n          <p class=\"f-sub\" data-i18n=\"fSub\">欢迎分享你的想法</p>\n          <h3 id=\"form-title\" data-fit=\"\" data-i18n=\"fTitle\"><span class=\"ln\"><span class=\"w2\">聊聊</span> <span class=\"w2\">你的项目</span></span></h3>\n          <div class=\"sw-fields\">\n            <label><span class=\"sw-label\" data-i18n=\"fName\">姓名 <em>*</em></span><input type=\"text\" name=\"name\" autocomplete=\"name\" required placeholder=\"姓名 *\" data-i18n-attr=\"placeholder:fNamePh\"></label>\n            <label><span class=\"sw-label\">Telegram / email <em aria-hidden=\"true\">*</em></span><input type=\"text\" name=\"contact\" required placeholder=\"Telegram / Email *\"></label>\n            \n            <label class=\"f-wide\"><textarea name=\"task\" rows=\"3\" placeholder=\"项目需求与时间安排\" aria-label=\"项目详情\" data-i18n-attr=\"placeholder:fTaskPh;aria-label:fTask\"></textarea></label>\n            <button class=\"btn btn-ink\" type=\"submit\" data-i18n=\"fSend\">预览留言 ↗</button>\n          </div>\n          <p class=\"f-note\" aria-live=\"polite\"></p>\n        </form>\n      </div>\n      <div class=\"sw-end sw-grid\"><p class=\"sw-label\">© 2026 Xianlin Lu</p><button class=\"sw-replay\" id=\"replay\" type=\"button\" data-i18n=\"replay\">重播故事 ↻</button></div>\n      <p class=\"sw-word\" aria-hidden=\"true\">xianlin_lu</p>\n    <p class=\"portfolio-credit\">Xianlin Lu 原创个人介绍 · 图库与数字为视觉参考展示</p></footer>",
